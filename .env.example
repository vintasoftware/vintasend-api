# Shared secret required on every /api/v1 request:
#   Authorization: Bearer <VINTASEND_API_KEY>
VINTASEND_API_KEY=

# Dotted path to the callable that builds your VintaSend service (see README).
# This is the same setting VintaSend's background-send worker reads.
NOTIFICATION_SERVICE_FACTORY=vintasend_api.vintasend_config.create_notification_service

# Optional: read from a non-primary backend registered in your VintaSend service.
VINTASEND_BACKEND_IDENTIFIER=

# Comma-separated list of allowed browser origins for CORS.
# Leave empty when only server-side clients (like the dashboard) call this API.
VINTASEND_API_CORS_ORIGINS=

# --- Django ---------------------------------------------------------------------
# This API signs nothing -- no sessions, no cookies, no CSRF-protected forms -- so
# the secret key is only here because Django refuses to start without one.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Comma-separated. Defaults to "*", which is only safe behind a proxy that sets Host.
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# The API never queries these itself. A database is only configured because some
# VintaSend backends (notably vintasend-django) resolve their model through Django.
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# --- Template preview -----------------------------------------------------------
# Only read when /preview is called, so the API runs fine without them.

# owner/repo, or a full GitHub repository URL.
GITHUB_REPO=
GITHUB_API_KEY=
# Optional: defaults to https://api.github.com
GITHUB_API_BASE_URL=
# Optional: prefixed to bodyTemplate/subjectTemplate paths before the GitHub fetch.
GITHUB_TEMPLATES_BASE_PATH=
GITHUB_TEMPLATE_CACHE_MAX_ENTRIES=100
GITHUB_TEMPLATE_TIMEOUT_SECONDS=10
